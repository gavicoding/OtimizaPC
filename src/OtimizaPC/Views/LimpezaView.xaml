<UserControl x:Class="OtimizaPC.Views.LimpezaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OtimizaPC.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             d:DataContext="{d:DesignInstance vm:LimpezaViewModel}"
             mc:Ignorable="d">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Limpeza" Style="{StaticResource Titulo}"/>
            <TextBlock Text="Escaneie e escolha o que apagar. Nada é excluído sem sua confirmação." Style="{StaticResource Subtitulo}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Escanear tudo" Style="{StaticResource BotaoPrimario}" Command="{Binding EscanearTudoCommand}"
                    IsEnabled="{Binding Escaneando, Converter={StaticResource InverterBool}}"/>
            <TextBlock Text="{Binding StatusGeral}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource CorTextoSecundario}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Categorias}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Cartao}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding Selecionado}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Nome}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Descricao}" Style="{StaticResource Subtitulo}" FontSize="11" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource CorTextoSecundario}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding TamanhoBytes, Converter={StaticResource BytesToString}}"
                                           FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" Style="{StaticResource Cartao}" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Visibility="{Binding Limpando, Converter={StaticResource InverterBoolParaVisibilidade}}">
                    <TextBlock Text="Total selecionado" Style="{StaticResource Subtitulo}" Margin="0"/>
                    <TextBlock Text="{Binding TamanhoTotalSelecionadoTexto}" FontSize="22" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding Limpando, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="🧹" FontSize="22" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Limpando..." FontWeight="Bold" Foreground="{StaticResource CorAcento}"/>
                        <TextBlock Text="{Binding StatusGeral}" FontSize="12" Foreground="{StaticResource CorTextoSecundario}"/>
                    </StackPanel>
                </StackPanel>

                <Button x:Name="BotaoLimpar" Grid.Column="1"
                        VerticalAlignment="Center" Click="BotaoLimpar_Click"
                        IsEnabled="{Binding Limpando, Converter={StaticResource InverterBool}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BotaoPerigo}">
                            <Setter Property="Content" Value="Limpar selecionados"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Limpando}" Value="True">
                                    <Setter Property="Content" Value="Limpando..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
