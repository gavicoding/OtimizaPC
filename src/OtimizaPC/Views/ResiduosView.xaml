<UserControl x:Class="OtimizaPC.Views.ResiduosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OtimizaPC.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             d:DataContext="{d:DesignInstance vm:ResiduosViewModel}"
             mc:Ignorable="d">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Resíduos de programas desinstalados" Style="{StaticResource Titulo}"/>
            <TextBlock Text="Verifica Program Files, AppData (Roaming e Local) e ProgramData — inclusive pastas ocultas — em busca de pastas que sobraram de programas já desinstalados. É uma estimativa por nome de pasta: revise a lista com atenção antes de excluir qualquer item." Style="{StaticResource Subtitulo}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Escanear" Style="{StaticResource BotaoPrimario}" Command="{Binding EscanearCommand}"
                    IsEnabled="{Binding Escaneando, Converter={StaticResource InverterBool}}"/>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource CorTextoSecundario}" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Itens}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Cartao}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding Selecionado}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Caminho}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Motivo}" Style="{StaticResource Subtitulo}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding TamanhoBytes, Converter={StaticResource BytesToString}}"
                                           FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" Style="{StaticResource Cartao}" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Total selecionado" Style="{StaticResource Subtitulo}" Margin="0"/>
                    <TextBlock Text="{Binding TamanhoSelecionadoTexto}" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
                <Button x:Name="BotaoExcluir" Grid.Column="1" Content="Excluir selecionados" Style="{StaticResource BotaoPerigo}"
                        VerticalAlignment="Center" Click="BotaoExcluir_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
